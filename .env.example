# Mail DB (accessed via sqlcmd only)
MAIL_DB_SERVER=your-mail-db-server
MAIL_DB_USER=your-mail-db-user
MAIL_DB_PASSWORD=your-mail-db-password

# ICMS DB (read) + insert target (write)
ICMS_SERVER=your-icms-server
ICMS_DB_USER=your-icms-db-user
ICMS_DB_PASSWORD=your-icms-db-password
INSERT_DB=EMail_Reader_Process_Data

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0